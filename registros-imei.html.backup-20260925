    measurementId: "G-7K4LP3MYL8"
  };
  firebase.initializeApp(firebaseConfig);
  const auth = firebase.auth();
  const db = firebase.firestore();

  const telegramConfig = {
    botToken: 'TU_TOKEN_DE_TELEGRAM_AQUI',
    chatIds: ['TU_ID_DE_ADMIN', 'OTRO_CHAT_ID'],
    enabled: true
  };

  let currentUser = null;
  let userProfile = null;
  let allServices = [];
  let filteredServices = [];
  let currentOrderService = null;
  let searchQuery = '';
  let currentBrandFilter = 'all';
  let currentSort = 'recent';

  // ✅ NUEVO: FUNCIÓN PARA PARSEAR TAGS CORRECTAMENTE (FIX DEL BUG)
  function parseTags(tags) {
    if (!tags) return [];
    
    // Si ya es un array, devolverlo limpio
    if (Array.isArray(tags)) {
      return tags.filter(t => typeof t === 'string' && t.trim() !== '');
    }
    
    // Si es string
    if (typeof tags === 'string') {
      // Intentar parsear como JSON primero
      try {
        const parsed = JSON.parse(tags);
        if (Array.isArray(parsed)) {
          return parsed.filter(t => typeof t === 'string' && t.trim() !== '');
        }
      } catch (e) {
        // No es JSON válido, continuar
      }
      
      // Limpiar caracteres JSON residuales
      let cleaned = tags
        .replace(/[\[\]"]/g, '')  // Quitar corchetes y comillas
        .replace(/\\n/g, ',')      // Reemplazar \n por coma
        .trim();
      
      // Split por coma
      return cleaned.split(',')
        .map(t => t.trim())
        .filter(t => t && t.length > 0);
    }
    
    return [];
  }

  // ✅ NUEVO: DETECTAR MARCA DEL SERVICIO
  function detectBrand(service) {
    const text = [
      service.name || '',
      service.description || '',
      parseTags(service.tags).join(' ')
    ].join(' ').toLowerCase();
    
    const brands = [
      { name: 'Samsung', keywords: ['samsung', 'galaxy', 'sm-', 'gt-', 'sch-'] },
      { name: 'Xiaomi', keywords: ['xiaomi', 'redmi', 'poco', ' mi ', 'mi account', 'miui'] },
      { name: 'Apple', keywords: ['apple', 'iphone', 'ipad', 'ios', 'icloud', 'hello iphone'] },
      { name: 'Honor', keywords: ['honor'] },
      { name: 'Huawei', keywords: ['huawei'] },
      { name: 'Motorola', keywords: ['motorola', 'moto '] },
      { name: 'LG', keywords: [' lg ', 'lg-', 'lg '] },
      { name: 'Realme', keywords: ['realme'] },
      { name: 'Oppo', keywords: ['oppo'] },
      { name: 'OnePlus', keywords: ['oneplus', 'one plus'] },
      { name: 'Tecno', keywords: ['tecno', 'infinix'] },
      { name: 'Nokia', keywords: ['nokia', 'hmd'] }
    ];
    
    for (const brand of brands) {
      for (const keyword of brand.keywords) {
        if (text.includes(keyword)) return brand.name;
      }
    }
    return null;
  }

  // ✅ NUEVO: OBTENER ICONO DE MARCA
  function getBrandIcon(brand) {
    const icons = {
      'Samsung': '📱',
      'Xiaomi': '🔶',
      'Apple': '🍎',
      'Honor': '⭐',
      'Huawei': '🌸',
      'Motorola': '🔷',
      'LG': '🔴',
      'Realme': '🟡',
      'Oppo': '🟢',
      'OnePlus': '➕',
      'Tecno': '🔵',
      'Nokia': '🟣'
    };
    return icons[brand] || '📲';
  }

  // ✅ NUEVO: VERIFICAR SI ES MÁS VENDIDO
  function isBestSeller(service) {
    const name = (service.name || '').toLowerCase();
    const bestSellers = [
      'samsung frp',
      'xiaomi mi account',
      'iphone bypass',
      'honor frp',
      'samsung unlock',
      'frp via imei'
    ];
    return bestSellers.some(bs => name.includes(bs));
  }

  // ✅ NUEVO: VERIFICAR SI ES NUEVO (menos de 7 días)
  function isNew(service) {
    if (!service.createdAt) return false;
    const created = new Date(service.createdAt);
    const now = new Date();
    const diffDays = (now - created) / (1000 * 60 * 60 * 24);
    return diffDays <= 7;
  }

  // ✅ NUEVO: EXTRAER MARCAS ÚNICAS DE LOS SERVICIOS
  function extractBrands(services) {
    const brandCount = {};
    services.forEach(service => {
      const brand = detectBrand(service);
      if (brand) {
        brandCount[brand] = (brandCount[brand] || 0) + 1;
      }
    });
    return brandCount;
  }

  // ✅ NUEVO: RENDERIZAR FILTROS DE MARCA
  function renderBrandFilters() {
    const container = document.getElementById('brandFilters');
    const brandCount = extractBrands(allServices);
    const brands = Object.entries(brandCount).sort((a, b) => b[1] - a[1]);
    
    let html = '<span class="brand-filter-label">🏷️ Filtrar por marca:</span>';
    
    // Botón "Todos"
    html += `<button class="brand-pill ${currentBrandFilter === 'all' ? 'active' : ''}" onclick="filterByBrand('all')">
      Todos <span class="pill-count">${allServices.length}</span>
    </button>`;
    
    // Botones por marca
    brands.forEach(([brand, count]) => {
      const icon = getBrandIcon(brand);
      html += `<button class="brand-pill ${currentBrandFilter === brand ? 'active' : ''}" onclick="filterByBrand('${brand}')">
        ${icon} ${brand} <span class="pill-count">${count}</span>
      </button>`;
    });
    
    container.innerHTML = html;
  }

  // ✅ NUEVO: FILTRAR POR MARCA
  function filterByBrand(brand) {
    currentBrandFilter = brand;
    applyFiltersAndSort();
    renderBrandFilters();
  }

  // ✅ NUEVO: MANEJAR ORDENAMIENTO
  function handleSort() {
    currentSort = document.getElementById('sortSelect').value;
    applyFiltersAndSort();
  }

  // ✅ NUEVO: APLICAR FILTROS Y ORDENAMIENTO
  function applyFiltersAndSort() {
    let result = [...allServices];
    
    // Aplicar búsqueda
    if (searchQuery) {
      result = result.filter(service => {
        const name = (service.name || '').toLowerCase();
        const description = (service.description || '').toLowerCase();
        const tags = parseTags(service.tags).join(' ').toLowerCase();
        
        return name.includes(searchQuery) || 
               description.includes(searchQuery) || 
               tags.includes(searchQuery);
      });
    }
    
    // Aplicar filtro de marca
    if (currentBrandFilter !== 'all') {
      result = result.filter(service => {
        const brand = detectBrand(service);
        return brand === currentBrandFilter;
      });
    }
    
    // Aplicar ordenamiento
    switch (currentSort) {
      case 'price-asc':
        result.sort((a, b) => (a.price || a.credits || 0) - (b.price || b.credits || 0));
        break;
      case 'price-desc':
        result.sort((a, b) => (b.price || b.credits || 0) - (a.price || a.credits || 0));
        break;
      case 'popular':
        result.sort((a, b) => {
          const aBest = isBestSeller(a) ? 1 : 0;
          const bBest = isBestSeller(b) ? 1 : 0;
          return bBest - aBest;
        });
        break;
      case 'name':
        result.sort((a, b) => (a.name || '').localeCompare(b.name || ''));
        break;
      case 'recent':
      default:
        result.sort((a, b) => {
          const dateA = a.createdAt ? new Date(a.createdAt) : new Date(0);
          const dateB = b.createdAt ? new Date(b.createdAt) : new Date(0);
          return dateB - dateA;
        });
    }
    
    filteredServices = result;
    renderServices();
    
    // Actualizar info de búsqueda
    const resultsInfo = document.getElementById('searchResultsInfo');
    if (searchQuery || currentBrandFilter !== 'all') {
      resultsInfo.classList.add('visible');
      document.getElementById('searchResultsCount').textContent = filteredServices.length;
      document.getElementById('searchTotalCount').textContent = allServices.length;
    } else {
      resultsInfo.classList.remove('visible');
    }
  }

  async function sendTelegramMessage(message) {
    if (!telegramConfig.enabled) return false;
    
    let allSuccess = true;
    
    for (const chatId of telegramConfig.chatIds) {
      try {
        const url = `https://api.telegram.org/bot${telegramConfig.botToken}/sendMessage`;
        
        const response = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            chat_id: chatId,
            text: message,
            parse_mode: 'HTML'
          })
        });
        
        const data = await response.json();
        
        if (data.ok) {
          console.log(`✅ Notificación enviada a chat ${chatId}`);
        } else {
          console.error(`❌ Error enviando a chat ${chatId}:`, data.description);
          allSuccess = false;
        }
      } catch (error) {
        console.error(`❌ Error de conexión con chat ${chatId}:`, error);
        allSuccess = false;
      }
    }
    
    return allSuccess;
  }

  async function notifyNewOrder(orderData) {
    const message = `
🆕 <b>NUEVO PEDIDO RECIBIDO</b>

👤 <b>Cliente:</b> ${orderData.userName || 'Usuario'}
📧 <b>Email:</b> ${orderData.userEmail || 'N/A'}
📦 <b>Servicio:</b> ${orderData.serviceName || 'N/A'}
💰 <b>Precio:</b> $${(orderData.servicePrice || 0).toFixed(2)}
📊 <b>Cantidad:</b> ${orderData.quantity || 1}
📅 <b>Fecha:</b> ${new Date().toLocaleString('es-ES')}

${orderData.imei ? `🔢 <b>IMEI:</b> <code>${orderData.imei}</code>\n` : ''}${orderData.ip ? `🌐 <b>IP:</b> <code>${orderData.ip}</code>\n` : ''}${orderData.sn ? `📱 <b>SN:</b> <code>${orderData.sn}</code>\n` : ''}
⏳ <b>Estado:</b> Pendiente de revisión
    `.trim();
    
    return await sendTelegramMessage(message);
  }

  auth.onAuthStateChanged(async (user) => {
    if (user) {
      currentUser = user;
      const profileDoc = await db.collection('profiles').doc(user.uid).get();
      if (profileDoc.exists) {
        userProfile = profileDoc.data();
        if (userProfile.role === 'admin' || userProfile.role === 'client') {
          document.getElementById('adminButtons').style.display = 'flex';
        }
      }
    }
    await loadServices();
    updateNav();
  });

  function updateNav() {
    const navAuth = document.getElementById('navAuth');
    if (currentUser && userProfile) {
      const name = userProfile.name || 'Usuario';
      const initial = name.charAt(0).toUpperCase();
      navAuth.innerHTML = `
        <div class="user-pill">
          <div class="user-avatar">${initial}</div>
          <span class="user-name">${name}</span>
          <button class="btn-logout-text" onclick="logout()">Cerrar Sesión</button>
        </div>
      `;
    } else {
      navAuth.innerHTML = `
        <a href="index.html" class="btn-ghost">Iniciar Sesión</a>
        <a href="index.html" class="btn-primary">Registrarse</a>
      `;
    }
  }

  function logout() {
    auth.signOut().then(() => {
      window.location.href = 'index.html';
    });
  }

  async function loadServices() {
    try {
      const servicesSnap = await db.collection('services')
        .where('category', '==', 'unlock')
        .get();
      
      allServices = servicesSnap.docs.map(doc => ({ id: doc.id, ...doc.data() }));
      
      // Renderizar filtros de marca
      renderBrandFilters();
      
      // Aplicar filtros y ordenamiento
      applyFiltersAndSort();
    } catch (error) {
      console.error('Error cargando servicios:', error);
      document.getElementById('servicesGrid').innerHTML = `
        <div class="empty-state">
          <p style="color:var(--red);">Error al cargar servicios</p>
          <button onclick="loadServices()" class="btn-primary" style="margin-top:20px;">🔄 Reintentar</button>
        </div>
      `;
    }
  }

  function handleSearch() {
    const input = document.getElementById('searchInput');
    const clearBtn = document.getElementById('searchClear');
    
    searchQuery = input.value.trim().toLowerCase();
    
    if (searchQuery) {
      clearBtn.classList.add('visible');
    } else {
      clearBtn.classList.remove('visible');
    }
    
    applyFiltersAndSort();
  }

  function clearSearch() {
    document.getElementById('searchInput').value = '';
    document.getElementById('searchClear').classList.remove('visible');
    document.getElementById('searchResultsInfo').classList.remove('visible');
    searchQuery = '';
    applyFiltersAndSort();
    document.getElementById('searchInput').focus();
  }

  function escapeRegExp(string) {
    return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  function renderServices() {
    const grid = document.getElementById('servicesGrid');
    
    if (filteredServices.length === 0) {
      if (searchQuery || currentBrandFilter !== 'all') {
        const filterText = currentBrandFilter !== 'all' ? `de la marca <strong style="color:var(--emerald);">${currentBrandFilter}</strong>` : '';
        const searchText = searchQuery ? `"<strong style="color:var(--emerald);">${searchQuery}</strong>"` : '';
        
        grid.innerHTML = `
          <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
            <p style="color:var(--emerald);font-size:18px;margin-bottom:8px;">No se encontraron resultados</p>
            <p style="color:var(--text-dim);">No hay servicios que coincidan ${filterText} ${searchText}</p>
            <button onclick="clearAllFilters()" class="btn-primary" style="margin-top:20px;">🔄 Limpiar filtros</button>
          </div>
        `;
      } else {
        grid.innerHTML = `
          <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
            </svg>
            <p>No hay servicios de registros IMEI disponibles</p>
          </div>
        `;
      }
      return;
    }
    
    const isAdmin = currentUser && (userProfile?.role === 'admin' || userProfile?.role === 'client');
    
    grid.innerHTML = filteredServices.map(service => {
      // ✅ FIX: Usar parseTags en lugar del procesamiento anterior
      const tags = parseTags(service.tags);
      const brand = detectBrand(service);
      const brandIcon = brand ? getBrandIcon(brand) : null;
      const bestSeller = isBestSeller(service);
      const newService = isNew(service);
      
      // Resaltar coincidencias
      let highlightedName = service.name;
      if (searchQuery) {
        const regex = new RegExp(`(${escapeRegExp(searchQuery)})`, 'gi');
        highlightedName = service.name.replace(regex, '<mark style="background:var(--emerald);color:var(--dark);padding:0 2px;border-radius:2px;">$1</mark>');
      }
      
      // ✅ NUEVO: Cinta de "Más vendido" o "Nuevo"
      let ribbonHTML = '';
      if (bestSeller) {
        ribbonHTML = '<div class="service-ribbon bestseller">🔥 Más Vendido</div>';
      } else if (newService) {
        ribbonHTML = '<div class="service-ribbon new">✨ Nuevo</div>';
      }
      
      // ✅ NUEVO: Icono de marca
      let brandIconHTML = '';
      if (brandIcon) {
        brandIconHTML = `<div class="brand-icon-badge" title="${brand || 'Marca'}">${brandIcon}</div>`;
      }
      
      return `
        <div class="service-card">
          ${ribbonHTML}
          ${brandIconHTML}
          
          ${isAdmin ? `
            <div class="service-actions">
              <button class="btn-edit" onclick="editService('${service.id}')">✏️</button>
              <button class="btn-delete" onclick="deleteService('${service.id}')">🗑️</button>
            </div>
          ` : ''}
          
          <div class="service-category">Registro IMEI/SN</div>
          <h3>${highlightedName}</h3>
          <p>${service.description || 'Sin descripción'}</p>
          
          <div class="service-badges">
            ${service.stock ? '<span class="badge stock">✓ En Stock</span>' : '<span class="badge out">Agotado</span>'}
            ${service.autoServer ? '<span class="badge auto">⚡ Auto</span>' : ''}
          </div>
          
          ${tags.length > 0 ? `
            <div class="service-tags">
              ${tags.map(tag => `<span class="tag">${tag}</span>`).join('')}
            </div>
          ` : ''}
          
          <div class="service-footer">
            <div class="service-price">$${parseFloat(service.price || service.credits || 0).toFixed(2)} <span>créditos</span></div>
            <button class="btn-select" onclick="selectService('${service.id}')">Comprar</button>
          </div>
        </div>
      `;
    }).join('');
  }

  // ✅ NUEVO: LIMPIAR TODOS LOS FILTROS
  function clearAllFilters() {
    document.getElementById('searchInput').value = '';
    document.getElementById('searchClear').classList.remove('visible');
    document.getElementById('searchResultsInfo').classList.remove('visible');
    document.getElementById('sortSelect').value = 'recent';
    searchQuery = '';
    currentBrandFilter = 'all';
    currentSort = 'recent';
    renderBrandFilters();
    applyFiltersAndSort();
  }

  function openAddModal() {
    document.getElementById('modalTitle').textContent = '➕ Agregar Servicio';
    document.getElementById('serviceForm').reset();
    document.getElementById('serviceId').value = '';
    document.getElementById('serviceModal').classList.add('open');
  }

  function closeServiceModal() {
    document.getElementById('serviceModal').classList.remove('open');
  }

  async function editService(serviceId) {
    const service = allServices.find(s => s.id === serviceId);
    if (!service) return;
    
    document.getElementById('modalTitle').textContent = '✏️ Editar Servicio';
    document.getElementById('serviceId').value = service.id;
    document.getElementById('serviceName').value = service.name || '';
    document.getElementById('serviceDesc').value = service.description || '';
    document.getElementById('servicePrice').value = service.price || service.credits || 0;
    document.getElementById('serviceStock').value = service.stock !== false ? 'true' : 'false';
    document.getElementById('serviceAuto').value = service.autoServer !== false ? 'true' : 'false';
    // ✅ FIX: Mostrar tags correctamente (sin JSON crudo)
    const tags = parseTags(service.tags);
    document.getElementById('serviceTags').value = tags.join(', ');
    document.getElementById('serviceProcessTime').value = service.processTime || '';
    document.getElementById('serviceAdditionalInfo').value = service.additionalInfo || '';
    document.getElementById('serviceIP').value = service.ip || '';
    
    document.getElementById('serviceModal').classList.add('open');
  }

  async function saveService(event) {
    event.preventDefault();
    
    const id = document.getElementById('serviceId').value;
    const tagsRaw = document.getElementById('serviceTags').value;
    const tagsArray = tagsRaw ? tagsRaw.split(',').map(t => t.trim()).filter(t => t) : [];
    
    const serviceData = {
      name: document.getElementById('serviceName').value,
      description: document.getElementById('serviceDesc').value,
      category: 'unlock',
      price: parseFloat(document.getElementById('servicePrice').value),
      credits: parseFloat(document.getElementById('servicePrice').value),
      stock: document.getElementById('serviceStock').value === 'true',
      autoServer: document.getElementById('serviceAuto').value === 'true',
      tags: tagsArray,
      processTime: document.getElementById('serviceProcessTime').value.trim(),
      additionalInfo: document.getElementById('serviceAdditionalInfo').value.trim(),
      ip: document.getElementById('serviceIP').value.trim(),
      updatedAt: new Date().toISOString()
    };
    
    try {
      if (id) {
        await db.collection('services').doc(id).update(serviceData);
        showToast('✅ Servicio actualizado', 'success');
      } else {
        serviceData.createdAt = new Date().toISOString();
        serviceData.createdBy = currentUser.uid;
        await db.collection('services').add(serviceData);
        showToast('✅ Servicio agregado', 'success');
      }
      
      closeServiceModal();
      await loadServices();
    } catch (error) {
      showToast('❌ Error: ' + error.message, 'error');
    }
  }

  async function deleteService(serviceId) {
    if (!confirm('¿Eliminar este servicio? Esta acción no se puede deshacer.')) return;
    
    try {
      await db.collection('services').doc(serviceId).delete();
      showToast('🗑️ Servicio eliminado', 'success');
      await loadServices();
    } catch (error) {
      showToast('❌ Error al eliminar: ' + error.message, 'error');
    }
  }

  function selectService(serviceId) {
    if (!currentUser) {
      showToast('⚠️ Debes iniciar sesión para comprar', 'error');
      setTimeout(() => {
        window.location.href = 'index.html';
      }, 2000);
      return;
    }
    
    const service = allServices.find(s => s.id === serviceId);
    if (!service) return;
    
    const price = service.price || service.credits || 0;
    const balance = userProfile?.balance || 0;
    
    if (balance < price) {
      showError('❌ No tienes suficiente saldo');
      document.getElementById('orderModal').classList.add('open');
      return;
    }
    
    currentOrderService = service;
    
    document.getElementById('orderServiceName').textContent = service.name;
    document.getElementById('orderPrice').textContent = '$' + price.toFixed(2);
    document.getElementById('orderBalance').textContent = '$' + balance.toFixed(2);
    
    document.getElementById('infoPrice').textContent = '$' + price.toFixed(2);
    document.getElementById('infoStatus').innerHTML = service.stock ? '<span style="color: var(--emerald);">✓ EN STOCK</span>' : '<span style="color: var(--red);">AGOTADO</span>';
    
    if (service.processTime) {
      document.getElementById('infoProcessTime').textContent = service.processTime;
      document.getElementById('infoTimeContainer').style.display = 'flex';
    } else {
      document.getElementById('infoTimeContainer').style.display = 'none';
    }
    
    if (service.additionalInfo) {
      document.getElementById('infoAdditional').textContent = service.additionalInfo;
      document.getElementById('infoAdditionalContainer').style.display = 'block';
    } else {
      document.getElementById('infoAdditionalContainer').style.display = 'none';
    }
    
    if (service.ip) {
      document.getElementById('infoIP').textContent = service.ip;
      document.getElementById('infoIPContainer').style.display = 'flex';
    } else {
      document.getElementById('infoIPContainer').style.display = 'none';
    }
    
    generateDynamicFields('unlock');
    hideError();
    
    document.getElementById('orderModal').classList.add('open');
  }

  function generateDynamicFields(category) {
    const container = document.getElementById('dynamicFields');
    let fieldsHTML = '';
    
    if (category === 'unlock' || category === 'remote') {
      fieldsHTML = `
        <div class="info-box">
          <strong>ℹ️ Información requerida:</strong><br>
          Para procesar este servicio, necesitamos el IMEI o número de serie del dispositivo.
        </div>
        
        <div class="form-group">
          <label>IMEI / Número de Serie *</label>
          <input type="text" id="orderIMEI" required placeholder="123456789012345">
          <small style="color:var(--text-dim);font-size:11px;margin-top:4px;display:block;">Marca *#06# en tu teléfono para ver el IMEI</small>
        </div>
      `;
    }
    
    container.innerHTML = fieldsHTML;
  }

  async function submitOrder(e) {
    e.preventDefault();
    
    if (!currentOrderService || !currentUser) return;
    
    hideError();
    
    const price = currentOrderService.price || currentOrderService.credits || 0;
    const balance = userProfile?.balance || 0;
    
    if (balance < price) {
      showError('❌ No tienes suficiente saldo');
      return;
    }
    
    const orderData = {
      userId: currentUser.uid,
      userEmail: currentUser.email,
      userName: userProfile.name || 'Usuario',
      serviceId: currentOrderService.id,
      serviceName: currentOrderService.name,
      servicePrice: price,
      unitPrice: price,
      quantity: 1,
      category: 'unlock',
      status: 'pending',
      paymentMethod: 'balance',
      createdAt: firebase.firestore.FieldValue.serverTimestamp(),
      updatedAt: firebase.firestore.FieldValue.serverTimestamp()
    };
    
    const imei = document.getElementById('orderIMEI')?.value.trim();
    if (!imei) {
      showError('⚠️ Por favor ingresa el IMEI/SN');
      return;
    }
    
    orderData.imei = imei;
    orderData.inputData = `IMEI/SN: ${imei}`;
    
    const confirmPurchase = confirm(
      `✅ Confirmar Compra\n\n` +
      `Servicio: ${currentOrderService.name}\n` +
      `Precio: $${price.toFixed(2)}\n` +
      `IMEI: ${imei}\n\n` +
      `¿Confirmas la compra?`
    );
    
    if (!confirmPurchase) return;
    
    try {
      await db.collection('orders').add(orderData);
      await notifyNewOrder(orderData);
      
      const newBalance = balance - price;
      await db.collection('profiles').doc(currentUser.uid).update({
        balance: newBalance,
        lastTransaction: firebase.firestore.FieldValue.serverTimestamp()
      });
      
      await db.collection('transactions').add({
        userId: currentUser.uid,
        userEmail: currentUser.email,
        userName: userProfile.name || 'Usuario',
        type: 'purchase',
        amount: -price,
        description: `Compra: ${currentOrderService.name}`,
        status: 'completed',
        balanceBefore: balance,
        balanceAfter: newBalance,
        completedAt: firebase.firestore.FieldValue.serverTimestamp(),
        createdAt: firebase.firestore.FieldValue.serverTimestamp()
      });
      
      userProfile.balance = newBalance;
      
      showToast('✅ ¡Pedido creado exitosamente!', 'success');
      closeOrderModal();
      
      setTimeout(() => {
        window.location.href = 'mis-pedidos.html';
      }, 2000);
      
    } catch (error) {
      console.error('Error creando pedido:', error);
      showError('❌ Error al crear el pedido: ' + error.message);
    }
  }

  function closeOrderModal() {
    document.getElementById('orderModal').classList.remove('open');
    document.getElementById('dynamicFields').innerHTML = '';
    currentOrderService = null;
    hideError();
  }

  function showError(message) {
    const errorDiv = document.getElementById('errorMessage');
    errorDiv.textContent = message;
    errorDiv.classList.add('show');
  }

  function hideError() {
    const errorDiv = document.getElementById('errorMessage');
    errorDiv.classList.remove('show');
  }

  function showToast(message, type = 'success') {
    let toastContainer = document.getElementById('toastContainer');
    if (!toastContainer) {
      toastContainer = document.createElement('div');
      toastContainer.id = 'toastContainer';
      toastContainer.className = 'toast-container';
      document.body.appendChild(toastContainer);
    }
    
    const toast = document.createElement('div');
    toast.className = `toast ${type}`;
    
    const icon = type === 'success' ? '✅' : '⚠️';
    toast.innerHTML = `<span>${icon}</span> ${message}`;
    
    toastContainer.appendChild(toast);
    
    setTimeout(() => {
      toast.style.animation = 'fadeOut 0.3s ease forwards';
      setTimeout(() => toast.remove(), 300);
    }, 4000);
  }

  document.getElementById('serviceModal').addEventListener('click', (e) => {
    if (e.target.id === 'serviceModal') closeServiceModal();
  });

  document.getElementById('orderModal').addEventListener('click', (e) => {
    if (e.target.id === 'orderModal') closeOrderModal();
  });

  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      document.getElementById('searchInput').focus();
    }
    if (e.key === 'Escape' && document.activeElement.id === 'searchInput') {
      clearSearch();
      document.getElementById('searchInput').blur();
    }
  });
</script>

</body>
