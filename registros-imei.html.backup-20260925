<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Registros IMEI / SN - ServiciosGF</title>
<link rel="icon" type="image/png" href="logo.png">
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;900&family=Rajdhani:wght@300;400;500;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">

<style>
  :root {
    --cyan: #00e5ff;
    --cyan-dim: #00b8cc;
    --cyan-glow: rgba(0,229,255,0.15);
    --cyan-border: rgba(0,229,255,0.3);
    --dark: #040a12;
    --dark2: #070d18;
    --dark3: #0a1220;
    --surface: #0f1e30;
    --text: #e0f4ff;
    --text-muted: #7ba8c4;
    --text-dim: #4a7a9b;
    --green: #00ff88;
    --emerald: #00ff88;
    --emerald-dim: #00cc6a;
    --emerald-glow: rgba(0,255,136,0.15);
    --emerald-border: rgba(0,255,136,0.3);
    --yellow: #ffcc00;
    --red: #ff4455;
    --purple: #8a2be2;
    --orange: #ff6b35;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: var(--dark); color: var(--text); font-family: 'Rajdhani', sans-serif; font-size: 16px; }

  nav { position: sticky; top: 0; z-index: 100; background: rgba(4, 10, 18, 0.95); backdrop-filter: blur(12px); border-bottom: 1px solid var(--cyan-border); padding: 0 40px; display: flex; align-items: center; justify-content: space-between; height: 64px; }
  .logo { display: flex; align-items: center; text-decoration: none; }
  .logo-img { height: 48px; width: auto; object-fit: contain; }
  .nav-links { display: flex; align-items: center; gap: 4px; list-style: none; }
  .nav-links a { color: var(--text-muted); text-decoration: none; font-size: 14px; font-weight: 600; letter-spacing: 0.08em; padding: 8px 14px; border-radius: 4px; transition: all 0.2s; text-transform: uppercase; }
  .nav-links a:hover { color: var(--emerald); background: var(--emerald-glow); }
  .nav-links a.active { color: var(--emerald); }
  
  .nav-dropdown { position: relative; }
  .nav-dropdown > a { cursor: pointer; }
  .dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background: var(--surface);
    border: 1px solid var(--cyan-border);
    border-radius: 6px;
    padding: 8px 0;
    min-width: 220px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.4);
    z-index: 1000;
  }
  .nav-dropdown:hover .dropdown-menu { display: block; }
  .dropdown-menu a {
    display: block;
    padding: 10px 20px;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 13px;
    transition: all 0.2s;
  }
  .dropdown-menu a:hover {
    background: var(--emerald-glow);
    color: var(--emerald);
  }
  
  .nav-actions { display: flex; gap: 10px; align-items: center; }
  .btn-ghost { background: transparent; border: 1px solid var(--emerald-border); color: var(--emerald); padding: 8px 20px; border-radius: 4px; font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; transition: all 0.2s; text-decoration: none; }
  .btn-ghost:hover { background: var(--emerald-glow); border-color: var(--emerald); }
  .btn-primary { background: var(--emerald); border: 1px solid var(--emerald); color: var(--dark); padding: 8px 20px; border-radius: 4px; font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; transition: all 0.2s; text-decoration: none; }
  .btn-primary:hover { background: var(--emerald-dim); box-shadow: 0 0 16px rgba(0,255,136,0.4); }
  .user-pill { display: flex; align-items: center; gap: 10px; background: var(--surface); border: 1px solid var(--cyan-border); padding: 6px 14px; border-radius: 20px; }
  .user-avatar { width: 24px; height: 24px; background: var(--emerald); color: var(--dark); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 12px; }
  .user-name { font-size: 13px; font-weight: 600; color: var(--text); }
  .btn-logout-text { background: rgba(255,68,85,0.15); border: 1px solid #ff4455; color: #ff4455; padding: 4px 12px; border-radius: 4px; font-size: 11px; font-weight: 600; cursor: pointer; transition: all 0.2s; font-family: 'Rajdhani', sans-serif; text-transform: uppercase; }
  .btn-logout-text:hover { background: #ff4455 !important; color: white !important; }

  .page-hero {
    padding: 80px 40px 40px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(0,255,136,0.08) 0%, transparent 70%);
  }
  .page-hero h1 {
    font-family: 'Orbitron', monospace;
    font-size: clamp(28px, 5vw, 48px);
    font-weight: 900;
    color: var(--text);
    margin-bottom: 12px;
  }
  .page-hero h1 .hl { color: var(--emerald); }
  .page-hero p {
    font-size: 16px;
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 auto;
  }

  .category-tabs-container {
    position: sticky;
    top: 64px;
    z-index: 90;
    background: var(--dark);
    border-bottom: 1px solid var(--cyan-border);
    padding: 12px 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  
  .category-tabs-container::-webkit-scrollbar { display: none; }

  .category-tabs {
    display: flex;
    gap: 10px;
    padding: 0 40px;
    min-width: max-content;
    align-items: center;
  }

  .category-tab {
    background: var(--surface);
    border: 1px solid var(--cyan-border);
    color: var(--text-muted);
    padding: 8px 16px;
    border-radius: 4px;
    font-family: 'Rajdhani', sans-serif;
    font-weight: 600;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .category-tab:hover {
    background: var(--emerald-glow);
    border-color: var(--emerald);
    color: var(--emerald);
  }

  .category-tab.active {
    background: var(--emerald);
    border-color: var(--emerald);
    color: var(--dark);
    font-weight: 700;
  }

  .services-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px;
  }

  .services-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    flex-wrap: wrap;
    gap: 20px;
  }

  .search-container {
    position: relative;
    flex: 1;
    max-width: 500px;
    min-width: 250px;
  }

  .search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 16px;
    color: var(--text-dim);
    font-size: 18px;
    pointer-events: none;
    transition: color 0.2s;
  }

  .search-input {
    width: 100%;
    background: var(--surface);
    border: 2px solid var(--emerald-border);
    color: var(--text);
    padding: 12px 48px 12px 48px;
    border-radius: 8px;
    font-family: 'Rajdhani', sans-serif;
    font-size: 15px;
    font-weight: 600;
    outline: none;
    transition: all 0.3s;
  }

  .search-input:focus {
    border-color: var(--emerald);
    box-shadow: 0 0 20px rgba(0,255,136,0.2);
    background: var(--dark3);
  }

  .search-input:focus + .search-icon,
  .search-input:focus ~ .search-icon {
    color: var(--emerald);
  }

  .search-input::placeholder {
    color: var(--text-dim);
    font-weight: 500;
  }

  .search-clear {
    position: absolute;
    right: 12px;
    background: transparent;
    border: none;
    color: var(--text-dim);
    font-size: 18px;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 4px;
    transition: all 0.2s;
    display: none;
  }

  .search-clear:hover {
    color: var(--red);
    background: rgba(255,68,85,0.1);
  }

  .search-clear.visible { display: block; }

  .search-results-info {
    margin-top: 8px;
    font-size: 13px;
    color: var(--text-muted);
    font-family: 'Share Tech Mono', monospace;
    display: none;
  }

  .search-results-info.visible { display: block; }
  .search-results-info .count { color: var(--emerald); font-weight: 700; }

  /* ✅ NUEVO: FILTROS POR MARCA */
  .brand-filters {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
    flex-wrap: wrap;
    align-items: center;
  }

  .brand-filter-label {
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-right: 4px;
    font-family: 'Share Tech Mono', monospace;
  }

  .brand-pill {
    background: var(--surface);
    border: 1px solid var(--emerald-border);
    color: var(--text-muted);
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    font-family: 'Rajdhani', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .brand-pill:hover {
    background: var(--emerald-glow);
    border-color: var(--emerald);
    color: var(--emerald);
  }

  .brand-pill.active {
    background: var(--emerald);
    border-color: var(--emerald);
    color: var(--dark);
    font-weight: 700;
  }

  .brand-pill .pill-count {
    background: rgba(0,0,0,0.2);
    padding: 1px 6px;
    border-radius: 10px;
    font-size: 10px;
    font-weight: 700;
  }

  .brand-pill.active .pill-count {
    background: rgba(0,0,0,0.3);
    color: var(--dark);
  }

  /* ✅ NUEVO: CONTROLES DE ORDENAMIENTO */
  .controls-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .sort-container {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sort-label {
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-family: 'Share Tech Mono', monospace;
  }

  .sort-select {
    background: var(--surface);
    border: 1px solid var(--emerald-border);
    color: var(--text);
    padding: 10px 14px;
    border-radius: 6px;
    font-family: 'Rajdhani', sans-serif;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    outline: none;
    transition: all 0.2s;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .sort-select:hover, .sort-select:focus {
    border-color: var(--emerald);
    background: var(--dark3);
  }

  .sort-select option {
    background: var(--dark2);
    color: var(--text);
  }

  .admin-buttons {
    display: none;
    gap: 12px;
    flex-shrink: 0;
  }

  .btn-add-service {
    background: var(--emerald);
    border: 1px solid var(--emerald);
    color: var(--dark);
    padding: 10px 24px;
    border-radius: 6px;
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .btn-add-service:hover {
    background: var(--emerald-dim);
    box-shadow: 0 0 20px rgba(0,255,136,0.4);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 24px;
  }

  .service-card {
    background: var(--surface);
    border: 1px solid var(--emerald-border);
    border-radius: 12px;
    padding: 24px;
    position: relative;
    transition: all 0.3s;
    background: linear-gradient(135deg, var(--surface) 0%, rgba(0,255,136,0.05) 100%);
    overflow: hidden;
  }

  .service-card:hover {
    border-color: var(--emerald);
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(0, 255, 136, 0.25);
  }

  /* ✅ NUEVO: CINTA "MÁS VENDIDO" / "NUEVO" */
  .service-ribbon {
    position: absolute;
    top: 14px;
    left: -10px;
    padding: 5px 14px 5px 18px;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: 0 4px 4px 0;
    z-index: 3;
    color: var(--dark);
    box-shadow: 0 3px 10px rgba(0,0,0,0.3);
    font-family: 'Rajdhani', sans-serif;
  }

  .service-ribbon.bestseller {
    background: linear-gradient(135deg, #ff6b35, #ffcc00);
  }

  .service-ribbon.new {
    background: linear-gradient(135deg, #00ff88, #00e5ff);
  }

  .service-ribbon::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 0;
    height: 0;
    border: 3px solid transparent;
    border-top-color: rgba(0,0,0,0.4);
    border-right-color: rgba(0,0,0,0.4);
  }

  /* ✅ NUEVO: ICONO DE MARCA */
  .brand-icon-badge {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 40px;
    height: 40px;
    background: var(--dark3);
    border: 1px solid var(--emerald-border);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    z-index: 2;
    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
  }

  .service-category {
    display: inline-block;
    padding: 4px 12px;
    background: var(--emerald-glow);
    color: var(--emerald);
    border-radius: 4px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 12px;
  }

  .service-card h3 {
    font-family: 'Orbitron', monospace;
    font-size: 18px;
    font-weight: 700;
    color: var(--emerald);
    margin-bottom: 8px;
    padding-right: 50px;
  }

  .service-card p {
    font-size: 14px;
    color: var(--text-muted);
    margin-bottom: 16px;
    line-height: 1.6;
  }

  .service-badges {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .badge {
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .badge.stock { background: var(--emerald-glow); color: var(--emerald); }
  .badge.auto { background: var(--emerald-glow); color: var(--emerald); }
  .badge.out { background: rgba(255,68,85,0.15); color: var(--red); }

  .service-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .tag {
    padding: 4px 10px;
    background: var(--dark3);
    border: 1px solid var(--emerald-border);
    border-radius: 4px;
    font-size: 11px;
    color: var(--text-muted);
  }

  .service-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 16px;
    border-top: 1px solid var(--emerald-border);
  }

  .service-price {
    font-family: 'Orbitron', monospace;
    font-size: 20px;
    font-weight: 700;
    color: var(--yellow);
  }

  .service-price span {
    font-size: 12px;
    color: var(--text-dim);
  }

  .btn-select {
    background: var(--emerald);
    color: var(--dark);
    padding: 8px 20px;
    border-radius: 4px;
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-select:hover {
    background: var(--emerald-dim);
    box-shadow: 0 0 16px rgba(0, 255, 136, 0.4);
  }

  .service-actions {
    position: absolute;
    top: 16px;
    right: 64px;
    display: flex;
    gap: 8px;
    z-index: 3;
  }

  .btn-edit, .btn-delete {
    background: var(--dark3);
    border: 1px solid var(--cyan-border);
    color: var(--cyan);
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 11px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-edit:hover {
    background: var(--cyan-glow);
    border-color: var(--cyan);
  }

  .btn-delete {
    border-color: var(--red);
    color: var(--red);
  }

  .btn-delete:hover {
    background: var(--red);
    color: white;
  }

  .empty-state {
    text-align: center;
    padding: 80px 20px;
    color: var(--text-dim);
    grid-column: 1 / -1;
  }

  .empty-state svg {
    width: 80px;
    height: 80px;
    margin-bottom: 20px;
    opacity: 0.3;
  }

  .loading {
    text-align: center;
    padding: 80px;
    color: var(--text-muted);
    font-family: 'Share Tech Mono', monospace;
    grid-column: 1 / -1;
  }

  .loading::after {
    content: ' Cargando servicios';
    animation: dots 1.5s steps(3, end) infinite;
  }

  @keyframes dots {
    0% { content: ' Cargando servicios'; }
    33% { content: ' Cargando servicios.'; }
    66% { content: ' Cargando servicios..'; }
    100% { content: ' Cargando servicios...'; }
  }

  .modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(4,10,18,0.9);
    backdrop-filter: blur(6px);
    z-index: 1000;
    align-items: center;
    justify-content: center;
  }

  .modal-overlay.open { display: flex; }

  .modal {
    background: var(--surface);
    border: 1px solid var(--cyan-border);
    border-radius: 12px;
    padding: 32px;
    width: 700px;
    max-width: 95vw;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    animation: modalSlideIn 0.3s ease;
  }

  @keyframes modalSlideIn {
    from { transform: translateY(-20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  .modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    color: var(--text-dim);
    font-size: 24px;
    cursor: pointer;
    transition: color 0.2s;
  }

  .modal-close:hover { color: var(--emerald); }

  .modal h2 {
    font-family: 'Orbitron', monospace;
    font-size: 20px;
    color: var(--emerald);
    margin-bottom: 8px;
  }

  .modal-sub {
    font-size: 14px;
    color: var(--text-muted);
    margin-bottom: 24px;
  }

  .form-group { margin-bottom: 18px; }

  .form-group label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 8px;
    font-family: 'Share Tech Mono', monospace;
  }

  .form-group input,
  .form-group textarea,
  .form-group select {
    width: 100%;
    background: var(--dark3);
    border: 1px solid var(--cyan-border);
    color: var(--text);
    padding: 12px 16px;
    border-radius: 4px;
    font-family: 'Rajdhani', sans-serif;
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s;
  }

  .form-group input:focus,
  .form-group textarea:focus,
  .form-group select:focus {
    border-color: var(--emerald);
  }

  .form-group textarea { resize: vertical; min-height: 80px; }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .modal-actions {
    display: flex;
    gap: 12px;
    margin-top: 24px;
  }

  .btn-full { width: 100%; padding: 14px; font-size: 15px; }

  .btn-save {
    background: var(--emerald);
    border: 1px solid var(--emerald);
    color: var(--dark);
    padding: 12px 24px;
    border-radius: 6px;
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s;
    width: 100%;
  }

  .btn-save:hover {
    background: var(--emerald-dim);
    box-shadow: 0 0 20px rgba(0,255,136,0.4);
  }

  .order-summary {
    background: var(--dark3);
    border: 1px solid var(--emerald-border);
    border-radius: 8px;
    padding: 16px;
    margin-bottom: 24px;
  }

  .summary-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1px solid var(--emerald-border);
  }

  .summary-item:last-child { border-bottom: none; }
  .summary-item span:first-child { color: var(--text-muted); font-size: 14px; }

  .summary-item .price {
    font-family: 'Orbitron', monospace;
    font-size: 20px;
    font-weight: 700;
    color: var(--yellow);
